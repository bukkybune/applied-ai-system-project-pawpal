# Copy this file to .env and fill in your key. .env is git-ignored, so the key
# never ends up on GitHub.

# Free key from https://aistudio.google.com/apikey (no credit card needed).
# Leave it empty to run PawPal in offline mode.
GEMINI_API_KEY=

# Optional: which Gemini model to use. Change it if AI Studio says this one is
# not available on your free tier.
PAWPAL_MODEL=gemini-3.8-flash

# Optional: a URL or email added to the Wikipedia User-Agent, which makes
# Wikipedia less likely to rate-limit you.
PAWPAL_WIKI_CONTACT=
